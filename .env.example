# Environment Variables ตัวอย่าง
# คัดลอกเป็น .env.local สำหรับ development

# Google Sheets
GOOGLE_SHEET_ID=1Z50JEzZq4bN0I0xiltNM58kf8nmhVWaVmDG3EzM0ScY
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google Drive (โฟลเดอร์รูปรถ)
GOOGLE_DRIVE_FOLDER_ID=1pbrVxfG37yspbLaJzrLH2qqQlkmOkBnZ

# Service Account ไม่มีพื้นที่เก็บไฟล์ของตัวเอง จึงอัปโหลดเข้า My Drive ตรง ๆ ไม่ได้
# เลือกทำอย่างใดอย่างหนึ่ง:
#   1) OAuth ในนามผู้ใช้จริง (ไม่ต้องเป็นผู้ดูแลระบบ) — ใช้ 3 ตัวแปรล่างสุด
#   2) domain-wide delegation — ใส่อีเมลผู้ใช้ Workspace ที่ให้สวมสิทธิ์แทน
#   3) ย้ายโฟลเดอร์รูปไปไว้ใน Shared Drive — ปล่อยทุกค่าว่างไว้
GOOGLE_IMPERSONATE_USER=

# OAuth (วิธีที่ 1) — สร้าง OAuth client ชนิด Desktop app แล้วรัน npm run get-token
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# Admin
ADMIN_PASSWORD=your_secure_password
